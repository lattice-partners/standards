# Copy to .env.local in this same directory and fill in. Never commit a
# filled-in copy.
#
# One file at the repo root serves both apps: each next.config.ts loads it via
# loadEnvConfig. Do not add per-app .env files; two copies drift.
#
# Values marked SERVER-ONLY must never appear in a NEXT_PUBLIC_ variable,
# in client components, or in logs. Anything prefixed NEXT_PUBLIC_ is shipped
# to the browser and is public by definition.

# ---------------------------------------------------------------------------
# Routing between the two apps
# ---------------------------------------------------------------------------

# Origin of the api app. apps/web rewrites /api/:path* here.
# Per environment: local, preview, and production each get their own value.
# Local default when running `npm run dev`: http://localhost:3001
API_URL=

# ---------------------------------------------------------------------------
# Clerk (authentication)
# Provisioned automatically by the Vercel Marketplace integration.
# ---------------------------------------------------------------------------

# Public. Identifies the Clerk instance to the browser.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# SERVER-ONLY. Full access to the Clerk Backend API.
CLERK_SECRET_KEY=

# Public. Where Clerk sends users to sign in and sign up.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ---------------------------------------------------------------------------
# Supabase (database)
# ---------------------------------------------------------------------------

# Public. The project REST endpoint.
NEXT_PUBLIC_SUPABASE_URL=

# Public. Low-privilege key (sb_publishable_...). Row Level Security still
# applies, so this is safe in the browser. Replaces the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY. High-privilege key (sb_secret_...) that bypasses Row Level
# Security. Replaces the legacy service_role key. Only use it for background
# jobs that genuinely act as the system, never in a request handler that is
# answering on behalf of a user.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Supabase CLI (local stack only)
# ---------------------------------------------------------------------------
#
# The Supabase CLI reads a separate `.env` at the repo root, not `.env.local`.
# Create `.env` (gitignored) with:
#
#   SUPABASE_AUTH_THIRD_PARTY_CLERK_DOMAIN=example.clerk.accounts.dev
#
# See supabase/README.md and stack/supabase/README.md.
