{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/before-shell-execution.mjs\"",
        "failClosed": true,
        "timeout": 15
      }
    ],
    "beforeReadFile": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/before-read-file.mjs\"",
        "failClosed": true,
        "timeout": 10
      }
    ],
    "sessionStart": [
      {
        "command": "node \"${CURSOR_PLUGIN_ROOT}/scripts/session-start.mjs\"",
        "timeout": 10
      }
    ]
  }
}
